# Wi-Fi access point settings, read by the hotspot container at each start.
# AP_ENABLED=no keeps the container idle and leaves the Wi-Fi card alone.
AP_ENABLED=no
AP_INTERFACE=wlan0
AP_SSID='Raspotify'
AP_PASSWORD=
AP_CHANNEL=6
AP_COUNTRY=FR
AP_ADDRESS=192.168.50.1
AP_PREFIX=24
AP_DHCP_START=192.168.50.10
AP_DHCP_END=192.168.50.100
AP_SHARE_INTERNET=yes
AP_UPLINK=eth0
AP_HIDDEN=no
