# Settings page served by the Pi itself (open http://<pi>.local:8080 from any browser).
FROM debian:trixie-slim

ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends python3 tini; \
    apt-get clean; rm -rf /var/lib/apt/lists/*

COPY reglages.py /usr/local/bin/reglages.py
RUN chmod 755 /usr/local/bin/reglages.py

ENTRYPOINT ["/usr/bin/tini", "--", "python3", "-I", "/usr/local/bin/reglages.py"]
